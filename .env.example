# Copy to .env and edit for your environment. .env is gitignored.

# --- Django core ---
# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
# Comma-separated list, e.g. "example.org,www.example.org"
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# SQLite (default). For Postgres: postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# --- Media / uploads ---
# Absolute path where stimulus audio files are stored. Defaults to ./media.
# MEDIA_ROOT=/var/lib/webeval/media
# Max per-file upload size in bytes (default ~10 MB audio, ~50 MB video).
# STIMULUS_MAX_UPLOAD_BYTES=10485760
# STIMULUS_MAX_VIDEO_UPLOAD_BYTES=52428800

# --- GeoIP (optional) ---
# Absolute path to a MaxMind GeoLite2-Country.mmdb file. If unset or missing,
# participant country_code is stored as NULL — the app does not fail.
# GEOIP_PATH=/var/lib/webeval/GeoLite2-Country.mmdb

# --- Accounts / studio ---
# Allow self-service researcher registration at /accounts/register/. Set to
# False to make the platform invitation-only (admins create users; collaborators
# join via invite links).
# ACCOUNTS_ALLOW_REGISTRATION=True

# Email backend. Defaults to the console backend (invitation links are printed
# to the server log). Use SMTP in production, e.g.:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=webeval <no-reply@example.org>

# Absolute base URL for links built outside a request context (reserved for
# future notification hooks). In-app invite links use the request host.
# SITE_URL=https://webeval.example.org
