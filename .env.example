# Copy to .env and edit for your environment. .env is gitignored.

# --- Django core ---
# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
# Comma-separated list, e.g. "example.org,www.example.org"
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# SQLite (default). For Postgres: postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# --- Media / uploads ---
# Absolute path where stimulus audio files are stored. Defaults to ./media.
# MEDIA_ROOT=/var/lib/webeval/media
# Max per-file upload size in bytes (default ~10 MB audio, ~50 MB video).
# STIMULUS_MAX_UPLOAD_BYTES=10485760
# STIMULUS_MAX_VIDEO_UPLOAD_BYTES=52428800

# --- GeoIP (optional) ---
# Absolute path to a MaxMind GeoLite2-Country.mmdb file. If unset or missing,
# participant country_code is stored as NULL — the app does not fail.
# GEOIP_PATH=/var/lib/webeval/GeoLite2-Country.mmdb

# --- Accounts / studio ---
# Allow self-service researcher registration at /accounts/register/. Set to
# False to make the platform invitation-only (admins create users; collaborators
# join via invite links).
# ACCOUNTS_ALLOW_REGISTRATION=True

# Email backend. Defaults to the console backend (invitation links are printed
# to the server log). Use SMTP in production, e.g.:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=webeval <no-reply@example.org>

# Absolute base URL for links built outside a request context (reserved for
# future notification hooks). In-app invite links use the request host.
# SITE_URL=https://webeval.example.org

# --- Production / deployment (see README "Production deployment") ---
# All of the below are off by default; tests and dev are unaffected.

# Turn on hardened transport/cookies once you're behind TLS. Implies HTTPS
# redirect, secure cookies, and HSTS (each overridable individually).
# SECURE_DEPLOY=True
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# Comma-separated https origins for CSRF (Django 4+ requires the scheme):
# CSRF_TRUSTED_ORIGINS=https://eval.example.org

# Serve static files from the app process (no nginx needed). The Docker image
# turns this on and runs `collectstatic`.
# USE_WHITENOISE=True

# Shared cache for rate limiting across worker processes (recommended in prod).
# REDIS_URL=redis://redis:6379/0

# API rate limits (DRF). Defaults: 30/min anonymous, 240/min per authenticated key.
# API_THROTTLE_ANON=30/min
# API_THROTTLE_USER=240/min

# S3-compatible object storage for media uploads (instead of local disk).
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=webeval-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# For non-AWS providers (MinIO, R2, Spaces), set the endpoint:
# AWS_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# AWS_DEFAULT_ACL=private

# docker-compose Postgres password (used by the bundled db service).
# POSTGRES_PASSWORD=webeval
